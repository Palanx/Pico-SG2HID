# pico-sg2hid — naming rules. Enforced by R-STYLE-02 (docs/constraints.md §Invariants).
#
# Verified against clang-tidy 23.1.0. NOTE: clang-tidy silently ignores CheckOptions
# keys it does not recognise — a typo here disables a rule with no error. The test
# behind R-STYLE-02 works by feeding it a deliberately misnamed sample and asserting
# that every category is reported, which is the only way to know these keys still bind.
#
# Scope: every .cpp and .h under src/ plus tests/*.cpp (tidy_sources() in tests/test_style.sh).
# clang-tidy needs to know how to compile the file, so a file under src/hal/, src/usb/,
# src/app/ or src/emu/ that includes a Pico SDK or TinyUSB header fails lint with
# clang-diagnostic-error until 03-pio-bus supplies its include flags.
#
# The flags are NOT trivial, and this comment used to say they were. Two are required and
# neither is guessable from a naming-rule failure, because both arrive as
# clang-diagnostic-error under WarningsAsErrors and therefore as a FAIL line naming
# R-STYLE-02: `-xc++` on a .h (compiled as C otherwise) and `-isysroot` on every file (else
# libc++ finds no platform C library and <array>, <optional>, <string_view>, <algorithm>,
# <functional> and <variant> all fail inside libc++ itself). Measured 2026-09-11; the
# invocation lives in tests/test_style.sh and the measurement in docs/constraints.md
# §Observed conventions.
#
# Upgrade path: NOT a generated compile_commands.json — ADR-0010 fixes development to macOS
# with Homebrew LLVM and settles this as explicit flags, so the two above are the answer
# rather than a stopgap. A compile database is still what src/hal/ and the SDK-facing layers
# would need, and 03-pio-bus owns that when it lands the CMake build.

Checks: '-*,readability-identifier-naming,readability-function-size,readability-magic-numbers'
WarningsAsErrors: '*'
# src/ and tests/, which is what 00-scaffold set and what R-STYLE-02 and R-CLEAN-02 are bound
# to. 01-ps2-codec narrowed this to 'src/.*' when it enabled readability-magic-numbers, to keep
# the literals under tests/vectors/ — R-CLEAN-04's own stated exception (R-PROTO-05) — out of
# reach, and reverted it on 2026-09-17 having measured that the narrowing bought nothing: those
# literals live in constexpr initializers, which readability-magic-numbers never diagnoses
# either way. What the narrowing cost was real: it also silenced naming and function-size
# diagnostics for every header under tests/, which are two other phases' bindings, and it made
# lint's reach depend on the checkout path, since the regex is unanchored and matched against
# the absolute path. Measured both ways in two clones, one under a path containing src/.
#
# A file passed as the main file is always diagnosed; this governs the headers it includes.
HeaderFilterRegex: '(src|tests)/.*'

CheckOptions:
  # Types read as CamelCase; things you call read as lower_case. The case tells you
  # which one you are looking at before you finish the word.
  - { key: readability-identifier-naming.ClassCase,              value: CamelCase }
  - { key: readability-identifier-naming.StructCase,             value: CamelCase }
  - { key: readability-identifier-naming.EnumCase,               value: CamelCase }
  - { key: readability-identifier-naming.EnumConstantCase,       value: CamelCase }
  - { key: readability-identifier-naming.TypeAliasCase,          value: CamelCase }
  - { key: readability-identifier-naming.TypedefCase,            value: CamelCase }
  - { key: readability-identifier-naming.TemplateParameterCase,  value: CamelCase }

  - { key: readability-identifier-naming.FunctionCase,           value: lower_case }
  - { key: readability-identifier-naming.MethodCase,             value: lower_case }
  - { key: readability-identifier-naming.ParameterCase,          value: lower_case }
  - { key: readability-identifier-naming.VariableCase,           value: lower_case }
  - { key: readability-identifier-naming.NamespaceCase,          value: lower_case }

  # Private state carries m_ so it is identifiable at the start of the name, not the
  # end. Chosen over a trailing _ (invisible on long names) and over a leading _
  # (legal for members, but one capital letter away from a reserved identifier).
  - { key: readability-identifier-naming.PrivateMemberPrefix,    value: m_ }
  - { key: readability-identifier-naming.PrivateMemberCase,      value: lower_case }
  - { key: readability-identifier-naming.ProtectedMemberPrefix,  value: m_ }
  - { key: readability-identifier-naming.ProtectedMemberCase,    value: lower_case }
  # Public members exist only on the plain-data structs core is built from (ADR-0002);
  # they are not private state and take no prefix.
  - { key: readability-identifier-naming.PublicMemberCase,       value: lower_case }

  # Compile-time constants are kCamelCase, so a protocol constant never looks like a
  # runtime variable at the call site.
  - { key: readability-identifier-naming.ConstexprVariableCase,   value: CamelCase }
  - { key: readability-identifier-naming.ConstexprVariablePrefix, value: k }
  - { key: readability-identifier-naming.GlobalConstantCase,      value: CamelCase }
  - { key: readability-identifier-naming.GlobalConstantPrefix,    value: k }
  - { key: readability-identifier-naming.MacroDefinitionCase,     value: UPPER_CASE }

  # R-CLEAN-02: a function fits on a screen and takes at most 3 parameters. Past
  # three, the arguments become a struct — on a bus API where half of them are
  # uint8_t, a swapped pair is a silent bug the compiler cannot see.
  - { key: readability-function-size.LineThreshold,      value: '60' }
  - { key: readability-function-size.ParameterThreshold, value: '3'  }
  - { key: readability-function-size.NestingThreshold,   value: '4'  }
